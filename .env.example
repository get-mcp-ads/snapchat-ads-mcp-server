# snapchat-ads-mcp-server configuration. See the README.

# Required. Comma-separated Snapchat ad account UUIDs this server may use.
# Requests for any other account are refused before they leave the machine.
# Organization IDs are not ad account IDs.
SNAPCHAT_ADS_ACCOUNT_IDS=

# Recommended: the refresh credentials of your own Snap Marketing API OAuth
# app. The server renews the access token in memory and never writes it to disk.
# All three are needed together.
SNAPCHAT_ADS_REFRESH_TOKEN=
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=

# Alternative for a short session: an access token alone. Snap access tokens
# expire after an hour, then the server reports HTTP 401 until you restart it
# with a new token.
# SNAPCHAT_ADS_ACCESS_TOKEN=

# Write tools are off by default. Only the exact value true registers the 25
# write tools. Every write still previews first and applies only on a second
# call with confirm: true.
SNAPCHAT_ADS_ENABLE_WRITES=false
